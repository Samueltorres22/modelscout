# Copy this file to .env and fill in real values. .env is gitignored.

ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the model used by the Extractor Agent. Extraction from a
# README isn't a reasoning-heavy task, so a cheaper model likely works fine --
# change this freely without touching code.
ANTHROPIC_EXTRACTOR_MODEL=claude-sonnet-5

# Matches the docker-compose.yml postgres service (port 5433 on the host to
# avoid clashing with any other local Postgres on the default 5432).
DATABASE_URL=postgresql://modelscout:modelscout_dev_only@localhost:5433/modelscout
